# Supabase público: estos dos valores pueden usarse en el navegador porque RLS protege los datos.
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# URL pública en producción. En local dejar localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SOLO SERVIDOR. Necesario al desplegar en Vercel para proteger las funciones Python internas.
# No usar prefijo NEXT_PUBLIC_. Generar una cadena aleatoria de 32+ caracteres.
ECO_PARSER_INTERNAL_SECRET=
